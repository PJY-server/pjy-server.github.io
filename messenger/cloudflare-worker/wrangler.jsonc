{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "friendschat-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "vars": { "APP_ORIGIN": "https://pjy-server.github.io" },
  "d1_databases": [{ "binding": "DB", "database_name": "friendschat-db", "database_id": "PASTE_D1_DATABASE_ID_HERE" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "friendschat-files" }]
}